MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

resolve-story-branches.sh can't update itself mid-flight — the shell
has already sourced the old version before the bootstrap replaces it.
Moving HEAD resolution into integration-test.sh fixes this because
the test script runs AFTER bootstrap, so it's always the fresh version.

The HEAD check now reads the PAT yaml and queries GitLab directly
from within the test runner.
---
 scripts/integration-test.sh       | 56 +++++++++++++++++++++++--------
 scripts/resolve-story-branches.sh | 24 -------------
 2 files changed, 42 insertions(+), 38 deletions(-)

diff --git a/scripts/integration-test.sh b/scripts/integration-test.sh
index eff6876..debdfcb 100755
--- a/scripts/integration-test.sh
+++ b/scripts/integration-test.sh
@@ -73,10 +73,8 @@ echo ""
 
 # --- Structural check: every in-flight story must have integration tests ---
 # --- and the HEAD component must have an open MR ---
-# STORY_ID, HEAD_COMPONENT, HEAD_HAS_MR are set by resolve-story-branches.sh
+# STORY_ID is set by resolve-story-branches.sh (exported to env)
 STORY_ID="${STORY_ID:-}"
-HEAD_COMPONENT="${HEAD_COMPONENT:-}"
-HEAD_HAS_MR="${HEAD_HAS_MR:-false}"
 
 if [ -n "${STORY_ID}" ] && [ "${STORY_ID}" != "TODOM-000" ]; then
   STORY_TEST_FILE="scripts/integration-tests/${STORY_ID}.sh"
@@ -87,18 +85,48 @@ if [ -n "${STORY_ID}" ] && [ "${STORY_ID}" != "TODOM-000" ]; then
     echo "  Expected: ${STORY_TEST_FILE}"
     echo "  Add story-level integration tests before shadow integration can pass."
     FAILURES=$((FAILURES + 1))
-  # Gate 2: HEAD component must have an open MR
-  elif [ -n "${HEAD_COMPONENT}" ] && [ "${HEAD_HAS_MR}" != "true" ]; then
-    echo "✗ STRUCTURAL FAILURE: HEAD component ${HEAD_COMPONENT} has no MR for ${STORY_ID}"
-    echo "  The HEAD component drives integration — shadow cannot pass without it."
-    echo "  Supporting MRs are expected to fail until HEAD is present."
-    FAILURES=$((FAILURES + 1))
   else
-    echo "${STORY_ID} — Story-level tests:"
-    sh "${STORY_TEST_FILE}"
-    STORY_EXIT=$?
-    if [ "${STORY_EXIT}" -ne 0 ]; then
-      FAILURES=$((FAILURES + STORY_EXIT))
+    # Gate 2: HEAD component must have an open MR
+    # Resolve HEAD from the PAT yaml (which was bootstrapped from the story branch)
+    HEAD_COMPONENT=""
+    HEAD_HAS_MR="false"
+    PAT_FILE="pats/${STORY_ID}.pat.yaml"
+
+    if [ -f "${PAT_FILE}" ]; then
+      HEAD_COMPONENT=$(grep -E '^head:' "${PAT_FILE}" | sed 's/^head:[[:space:]]*//' || true)
+    fi
+
+    if [ -n "${HEAD_COMPONENT}" ]; then
+      # Check if HEAD component has an open MR for this story
+      GITLAB_URL="${GITLAB_URL:-https://gitlab.com}"
+      TOKEN="${M_GROUP_TOKEN:-${CI_JOB_TOKEN:-}}"
+      GROUP="${GROUP:-}"
+      ENCODED_HEAD=$(echo "${GROUP}/${HEAD_COMPONENT}" | sed 's|/|%2F|g')
+
+      if [ -n "${TOKEN}" ] && [ -n "${GROUP}" ]; then
+        HEAD_MR_JSON=$(curl -sf --header "PRIVATE-TOKEN: ${TOKEN}" \
+          "${GITLAB_URL}/api/v4/projects/${ENCODED_HEAD}/merge_requests?state=opened&per_page=20" 2>/dev/null || echo "[]")
+        HEAD_BRANCH=$(echo "${HEAD_MR_JSON}" | grep -oE '"source_branch":"[^"]*'"${STORY_ID}"'[^"]*"' | head -1 | sed 's/"source_branch":"//;s/"//')
+        if [ -n "${HEAD_BRANCH}" ]; then
+          HEAD_HAS_MR="true"
+        fi
+      fi
+
+      echo "HEAD component: ${HEAD_COMPONENT} (MR present: ${HEAD_HAS_MR})"
+    fi
+
+    if [ -n "${HEAD_COMPONENT}" ] && [ "${HEAD_HAS_MR}" != "true" ]; then
+      echo "✗ STRUCTURAL FAILURE: HEAD component ${HEAD_COMPONENT} has no MR for ${STORY_ID}"
+      echo "  The HEAD component drives integration — shadow cannot pass without it."
+      echo "  Supporting MRs are expected to fail until HEAD is present."
+      FAILURES=$((FAILURES + 1))
+    else
+      echo "${STORY_ID} — Story-level tests:"
+      sh "${STORY_TEST_FILE}"
+      STORY_EXIT=$?
+      if [ "${STORY_EXIT}" -ne 0 ]; then
+        FAILURES=$((FAILURES + STORY_EXIT))
+      fi
     fi
   fi
 fi
diff --git a/scripts/resolve-story-branches.sh b/scripts/resolve-story-branches.sh
