@@ -0,0 +1,27 @@
+import request from 'supertest'
+import app from '../src/app.js'
+import db from '../src/db.js'
+
+describe('TODOM-001 — todo-m-api-read', () => {
+  beforeEach(() => {
+    db.exec('DELETE FROM todos')
+  })
+
+  it('GET /todos returns empty array when no todos', async () => {
+    const res = await request(app).get('/todos')
+    expect(res.status).toBe(200)
+    expect(res.body).toEqual([])
+  })
+
+  it('GET /todos returns todo list', async () => {
+    db.prepare('INSERT INTO todos (title) VALUES (?)').run('Buy milk')
+    db.prepare('INSERT INTO todos (title) VALUES (?)').run('Walk dog')
+
+    const res = await request(app).get('/todos')
+    expect(res.status).toBe(200)
+    expect(res.body).toHaveLength(2)
+    expect(res.body[0]).toHaveProperty('id')
+    expect(res.body[0]).toHaveProperty('title', 'Buy milk')
+    expect(res.body[1]).toHaveProperty('title', 'Walk dog')
+  })
+})
