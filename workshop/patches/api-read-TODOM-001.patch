diff --git a/Dockerfile b/Dockerfile
index cbd3874..63eb398 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,7 +1,10 @@
 FROM node:20-alpine
+RUN apk add --no-cache python3 make g++
 WORKDIR /app
 COPY package.json package-lock.json ./
 RUN npm ci --omit=dev
 COPY src/ src/
+RUN mkdir -p /data
+ENV DB_PATH=/data/todos.db
 EXPOSE 3002
 CMD ["node", "src/server.js"]
